# LALABA Partner App (Merchant / Home Washer / Courier / Staff) — env template.
# Copy to .env and fill in the blanks. .env is gitignored; never commit real keys.
# Everything here ships inside the app bundle and is extractable by an attacker —
# EXPO_PUBLIC_* values are NOT secrets. Real secrets belong on the backend only.

# ── Backend selection ────────────────────────────────────────────────────────
# off = local backend (recommended during development, per team convention)
# on  = hosted backend at EXPO_PUBLIC_ONLINE_GRAPHQL_URL
EXPO_PUBLIC_ONLINE=off

# Local backend. Use your machine's LAN IP (not localhost) when running on a
# physical device; localhost only works on the iOS simulator.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3001/graphql
EXPO_PUBLIC_DEVICE_API_BASE_URL=http://192.168.1.100:3001/graphql

# Hosted backend (used when EXPO_PUBLIC_ONLINE=on)
EXPO_PUBLIC_ONLINE_GRAPHQL_URL=

# ── Firebase (DEV project) ───────────────────────────────────────────────────
# From Firebase Console → Project settings → General → Your apps (Web app).
EXPO_PUBLIC_FIREBASE_API_KEY_DEV=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN_DEV=
EXPO_PUBLIC_FIREBASE_PROJECT_ID_DEV=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET_DEV=
EXPO_PUBLIC_FIREBASE_SENDER_ID_DEV=
EXPO_PUBLIC_FIREBASE_APP_ID_DEV=

# Staging / production variants are read by the same config module when
# EXPO_PUBLIC_ENV is set to stg/prod. Leave blank until those projects exist.
# EXPO_PUBLIC_ENV=
# EXPO_PUBLIC_FIREBASE_API_KEY_STG=
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN_STG=
# EXPO_PUBLIC_FIREBASE_PROJECT_ID_STG=
# EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET_STG=
# EXPO_PUBLIC_FIREBASE_SENDER_ID_STG=
# EXPO_PUBLIC_FIREBASE_APP_ID_STG=
# EXPO_PUBLIC_FIREBASE_API_KEY=
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=
# EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
# EXPO_PUBLIC_FIREBASE_SENDER_ID=
# EXPO_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Auth emulator (fully offline login) ─────────────────────────────
# true = route auth to the local emulator started by ../scripts/emulator.sh
EXPO_PUBLIC_USE_EMULATOR=false
# Host override — leave unset. src/config/firebase.ts already picks per platform
# (Android AVD 10.0.2.2, iOS sim/web localhost). Set only for a physical device,
# which reaches neither — use the Mac's LAN IP.
# EXPO_PUBLIC_EMULATOR_HOST=192.168.x.x

# ── Google ───────────────────────────────────────────────────────────────────
# OAuth Web client ID (Google Cloud Console → Credentials) for Google sign-in.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Maps SDK keys — the courier map uses platform-specific keys. Restrict each by
# bundle ID / package name in Google Cloud Console.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_ANDROID=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_IOS=

# ── Session (POS/staff idle handling) ────────────────────────────────────────
EXPO_PUBLIC_SESSION_TIMEOUT_MIN=30
EXPO_PUBLIC_SESSION_WARNING_SEC=60

# APPCHK-016X — EXPERIMENTAL device spike, default off.
# Bridges native App Check (Play Integrity / App Attest) into the Firebase JS
# SDK so firebase/auth can attach X-Firebase-AppCheck to Auth requests. Proves
# whether the APPCHK-016 Auth migration can be avoided entirely.
# Device test order: Customer Android -> Customer iOS -> Partner Android -> Partner iOS.
# STOP if a Partner process restart stops requiring a fresh login (X9).
# EXPO_PUBLIC_APPCHK_016X=on
